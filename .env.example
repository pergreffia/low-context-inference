# Server
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
# Compose-only: host-published API port (maps to the container's fixed 8080)
# PROXY_PORT=11435
SERVER__LOG_LEVEL=INFO
SERVER__LOG_JSON=false
SERVER__MAX_BODY_BYTES=8388608
SERVER__MAX_CAPTURE_BYTES=2097152

# M5 resilience (upstream transport retries + circuit breaker)
RESILIENCE__MAX_RETRIES=2
RESILIENCE__BACKOFF_BASE_SECONDS=0.2
RESILIENCE__BREAKER_FAILURE_THRESHOLD=5
RESILIENCE__BREAKER_RESET_SECONDS=30

# M5 rate limiting (in-process token bucket; single-instance scope)
# Admission = client/IP bucket + conversation bucket; memory bounded by
# RATE_LIMIT__MAX_IDENTITIES across both dimensions.
RATE_LIMIT__ENABLED=false
RATE_LIMIT__REQUESTS_PER_MINUTE=120
RATE_LIMIT__BURST=30
RATE_LIMIT__MAX_IDENTITIES=10000
RATE_LIMIT__IDENTITY_TTL_SECONDS=3600
RATE_LIMIT__MAX_IDENTITY_CHARS=256

# Security boundary for /internal/*
# SECURITY__MODE=production REQUIRES SECURITY__INTERNAL_AUTH_TOKEN: the proxy
# refuses to start otherwise (fail-closed). development keeps local use open.
SECURITY__MODE=development
SECURITY__INTERNAL_AUTH_TOKEN=

# PostgreSQL (source of truth)
DATABASE__URL=postgresql://context_proxy:context_proxy@localhost:5432/context_proxy
POSTGRES_USER=context_proxy
POSTGRES_PASSWORD=context_proxy
POSTGRES_DB=context_proxy

# Inference endpoint (OpenAI-compatible)
# Model selection belongs to the client request; there is intentionally NO
# INFERENCE__MODEL setting.
INFERENCE__BASE_URL=http://localhost:8000/v1
INFERENCE__API_KEY=

# Conversation identity (precedence: body > X-Conversation-ID > this header > UUID)
CONVERSATION__CLIENT_ID_HEADER=X-Session-ID

# Context budget (master prompt §14-§15)
CONTEXT__MODEL_LIMIT_TOKENS=32768
CONTEXT__SAFETY_MARGIN_TOKENS=2048
CONTEXT__RECENT_TARGET_TOKENS=14000
CONTEXT__RECENT_MIN_TOKENS=10000
CONTEXT__RECENT_MAX_TOKENS=18000

# Compact endpoint (system-owned model; reserved for future compaction flow)
COMPACT__BASE_URL=http://localhost:8001/v1
COMPACT__API_KEY=local
COMPACT__MODEL=compact-model

# Qdrant vector store (derived index, rebuildable from PostgreSQL)
QDRANT__BASE_URL=http://localhost:6333
QDRANT__COLLECTION=context_proxy

# Hybrid retrieval scoring (master prompt §19)
RETRIEVAL__SEMANTIC_WEIGHT=0.40
RETRIEVAL__LEXICAL_WEIGHT=0.25
RETRIEVAL__RECENCY_WEIGHT=0.15
RETRIEVAL__IMPORTANCE_WEIGHT=0.15
RETRIEVAL__TYPE_WEIGHT=0.05
RETRIEVAL__LIMIT_DEFAULT=8

# Context Assembly Engine (M4, master prompt §11)
ASSEMBLY__ENABLED=true
ASSEMBLY__MMR_LAMBDA=0.7
ASSEMBLY__MAX_RETRIEVED_ITEMS=8
ASSEMBLY__RETRIEVED_BUDGET_TOKENS=4000

# Memory service
MEMORY__AUTO_INDEX=true

# Embedding endpoint (system-owned model; static configuration)
EMBEDDINGS__BASE_URL=http://localhost:8002/v1
EMBEDDINGS__API_KEY=local
EMBEDDINGS__MODEL=embedding-model
